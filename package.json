{
  "name": "cppmod",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cfmt": "passable -i -q \"CMakeLists.txt\" \"src/**/CMakeLists.txt\" \"src/**/*.cmake\" \"config/*.cmake\"",
    "format": "tools format bun && bun run cfmt",
    "fmt": "bun run format",
    "clean": "bun run config/clean.ts",
    "dcfg": "cmake --preset debug",
    "rcfg": "cmake --preset release",
    "cfg": "bun run dcfg && bun run rcfg",
    "dcpp": "cmake --build build/Debug",
    "rcpp": "cmake --build build/Release",
    "cpp": "bun run dcpp && bun run rcpp",
    "dtst": "bun run dcpp && cd build/Debug && ctest --output-on-failure",
    "dtest": "bun run dcpp && cd build/Debug && ctest --output-on-failure",
    "rtst": "bun run rcpp && cd build/Release && ctest",
    "rtest": "bun run rcpp && cd build/Release && ctest",
    "tst": "bun run dtst && bun run rtst",
    "test": "bun run tst",
    "drun": "bun run os drun",
    "rrun": "bun run os rrun",
    "drun:win": "cmd /c build\\\\Debug\\\\src\\\\cppmod.exe",
    "rrun:win": "cmd /c build\\\\Release\\\\src\\\\cppmod.exe",
    "drun:def": "./build/Debug/src/cppmod",
    "rrun:def": "./build/Release/src/cppmod",
    "run": "bun run drun && bun run rrun",
    "*-*": "Helper to do OS-specific things",
    "os": "bun run config/os.ts",
    "prepare": "bunx simple-git-hooks",
    "****": "Stuff related to modules:",
    "mod_help": "bun run config/module-manager.ts help",
    "mod_cfg": "bun run config/module-manager.ts config",
    "mod_bld": "bun run config/module-manager.ts demand_std",
    "mod_cmake": "bun run config/module-manager.ts cmake config/mod_cfg.cmake",
    "mod": "bun run config/module-manager.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ],
    "*.cmake": [
      "passable -i"
    ],
    "CMakeLists.txt": [
      "passable -i"
    ],
    "*.{cpp,hpp,c,h,cc,hh,cppm}": [
      "clang-format -i"
    ]
  },
  "devDependencies": {
    "@freik/passable": "^0.2.1",
    "@freik/ts-cpp-tooling": "^0.6.2",
    "@freik/workspace": "^0.8.1",
    "@types/bun": "^1.3.14",
    "clang-format": "^1.8.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3"
  }
}
